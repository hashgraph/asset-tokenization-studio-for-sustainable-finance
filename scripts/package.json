{
  "name": "@hashgraph/green-bonds-scripts",
  "version": "1.0.0",
  "description": "Utility scripts for Evercity Green Bonds Platform",
  "private": true,
  "scripts": {
    "sign": "node utils/transaction-signer.js",
    "sign-and-send": "node utils/transaction-sign-and-send.js",
    "ats:bond": "node ats/bond/bond-simulator.js",
    "ats:mint-bond": "node ats/bond/mint-bond.js",
    "ats:check-roles": "node ats/bond/check-roles.js",
    "ats:grant-role": "node ats/bond/grant-role.js",
    "ats:check-db": "node ats/bond/check-db.js",
    "ats:set-bond-document": "node ats/bond/document/set-bond-document.js",
    "ats:remove-bond-document": "node ats/bond/document/remove-bond-document.js",
    "ats:set-bond-cap": "node ats/bond/cap/set-bond-cap.js",
    "ats:add-control-list-member": "node ats/bond/controllist/add-control-list-member.js",
    "ats:remove-control-list-member": "node ats/bond/controllist/remove-control-list-member.js",
    "ats:set-bond-coupon": "node ats/bond/coupon/set-bond-coupon.js",
    "ats:get-bond-coupons": "node ats/bond/coupon/get-bond-coupons.js",
    "ats:create-bond-lock": "node ats/bond/lock/create-bond-lock.js",
    "ats:release-bond-lock": "node ats/bond/lock/release-bond-lock.js",
    "ats:get-bond-locks": "node ats/bond/lock/get-bond-locks.js",
    "ats:get-bond-lock": "node ats/bond/lock/get-bond-lock.js --",
    "primary-market:offering": "node primary-market/offering/offering-simulator.js",
    "all:start": "node shared/infra/infra-setup.js start",
    "all:stop": "node shared/infra/infra-setup.js stop",
    "all:status": "node shared/infra/infra-setup.js status",
    "docker:start": "node shared/infra/infra-setup.js start docker",
    "docker:stop": "node shared/infra/infra-setup.js stop",
    "apis:start": "node shared/infra/infra-setup.js start apis",
    "apis:stop": "node shared/infra/infra-setup.js stop"
  },
  "license": "Apache-2.0"
}
