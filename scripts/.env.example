# Evercity Green Bonds Simulator Environment Variables

# Blockchain Format Configuration
# Choose 'hedera' or 'ethereum'
BLOCKCHAIN_FORMAT=hedera

# Private Keys for Transaction Signing
# Hedera Private Key (ed25519 DER format)
HEDERA_PRIVATE_KEY=your-hedera-private-key-in-der-format

# Ethereum Private Key (ecdsa hex format, with or without 0x prefix)
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key-in-hex-format

# Hedera Account ID( If format is hedera use ed25519, if ethereum use ethereum ecdsa)
ACCOUNT_ID=your-hedera-account-id
ACCOUNT_EVM_ADDRESS=your-ethereum-evm-address

# Ethereum gas price (only for ethereum blockchain format)
ETHEREUM_GAS_PRICE_GWEI=700

# API Configuration
GATEWAY_API_URL=http://localhost:3000
API_KEY=demo-key-1
RABBITMQ_URL=amqp://localhost:5672

RESOLVER_ADDRESS=0x45272CfeB1777AFAE2bfBbED168030349d2A82D6
FACTORY_ADDRESS=0x4cC2c9A06763e54c0F56b3B817656F7196f1E785