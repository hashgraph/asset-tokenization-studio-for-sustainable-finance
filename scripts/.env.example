# Evercity Green Bonds Simulator Environment Variables

# Blockchain Format Configuration
# Choose 'hedera' or 'ethereum'
BLOCKCHAIN_FORMAT=hedera

# Private Keys for Transaction Signing
# Hedera Private Key (DER format)
HEDERA_PRIVATE_KEY=your-hedera-private-key-in-der-format

# Ethereum Private Key (hex format, with or without 0x prefix)
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key-in-hex-format

# Hedera Account ID
ACCOUNT_ID=your-hedera-account-id

# API Configuration
ATS_API_URL=http://localhost:3000
RABBITMQ_URL=amqp://localhost:5672