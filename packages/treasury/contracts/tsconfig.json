{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "alwaysStrict": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@configuration": ["./Configuration"],
      "@contract-types": ["./typechain-types/index.ts"],
      "@contract-types/*": ["./typechain-types/*"],
      "@scripts": ["./scripts/index.ts"],
      "@scripts/domain": ["./scripts/domain/index.ts"],
      "@tasks": ["./tasks/index.ts"],
      "@test": ["./test/index.ts"]
    }
  },
  "include": ["scripts/**/*", "typechain-types/**/*", "test", "tasks"],
  "exclude": ["node_modules", "build", "dist", "coverage", "artifacts", "cache"],
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
