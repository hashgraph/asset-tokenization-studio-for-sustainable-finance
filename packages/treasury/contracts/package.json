{
  "name": "@hashgraph/green-bonds-platform-treasury-contracts",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "./build/typechain-types/index.js",
  "types": "./build/typechain-types/index.d.ts",
  "files": [
    "artifacts/",
    "contracts/",
    "typechain-types/",
    "scripts/",
    "build/",
    "!artifacts/build-info/",
    "!build/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./build/typechain-types/index.d.ts",
      "require": "./build/typechain-types/index.js"
    },
    "./artifacts/*": "./artifacts/*",
    "./contracts/*": "./contracts/*",
    "./scripts/": "./scripts/index.ts",
    "./scripts": {
      "types": "./build/scripts/index.d.ts",
      "require": "./build/scripts/index.js"
    },
    "./typechain-types": {
      "types": "./build/typechain-types/index.d.ts",
      "require": "./build/typechain-types/index.js"
    },
    "./test": {
      "types": "./build/test/index.d.ts",
      "require": "./build/test/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": ["hedera", "smart-contracts", "tokenization", "hardhat"],
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "npx hardhat clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:sol; npm run lint:js",
    "lint:fix": "npm run lint:sol:fix; npm run lint:js:fix",
    "lint:sol": "solhint --config solhint.config.js 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint --config solhint.config.js 'contracts/**/*.sol' --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "fix": "npm run format; npm run lint:fix",
    "generate:registry": "npx ts-node -r tsconfig-paths/register scripts/tools/generateRegistry.ts",
    "compile": "npx hardhat compile",
    "compile:force": "npm run clean && npm run compile && npx tsc",
    "build": "npx -y rimraf build && npm run compile && npx tsc -p tsconfig.json",
    "test": "hedera start -d && npx hardhat test; hedera stop",
    "test:lifecyclecashflow": "hedera start -d && npx hardhat test test/lifecyclecashflow.test.ts; hedera stop",
    "test:portfolio": "hedera start -d && npx hardhat test test/portfolio.test.ts; hedera stop",
    "test:proceedsmanagement": "hedera start -d && npx hardhat test test/proceedsmanagement.test.ts; hedera stop",
    "test:coverage": "npx hardhat coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@hashgraph/asset-tokenization-contracts": "file:/Users/work/Projects/npm-registry-mock/ats/hashgraph-asset-tokenization-contracts-1.17.14.tgz",
    "@hashgraph/sdk": "2.66.0",
    "@hashgraph/smart-contracts": "github:hashgraph/hedera-smart-contracts#v0.10.1",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@nomiclabs/hardhat-etherscan": "3.1.8",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@openzeppelin/hardhat-upgrades": "^1.22.1",
    "@primitivefi/hardhat-dodoc": "^0.2.3",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "blob": "^0.1.0",
    "chai": "^4.4.0",
    "dotenv": "^16.0.3",
    "eslint": "^9.24.0",
    "ethers": "^5.8.0",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "hardhat": "^2.22.19",
    "hardhat-abi-exporter": "^2.11.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-dependency-compiler": "^1.2.1",
    "hardhat-gas-reporter": "^1.0.8",
    "jiti": "^2.6.0",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "^1.4.2",
    "rimraf": "^6.0.1",
    "solhint": "^5.0.3",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.44.0"
  }
}
