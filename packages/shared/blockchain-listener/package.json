{
  "name": "@hashgraph/green-bonds-blockchain-listener",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:test": "ts-node -r tsconfig-paths/register test/main.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@hashgraph/green-bonds-shared-core": "*",
    "@hiero-ledger/sdk": "2.79.0",
    "@golevelup/nestjs-rabbitmq": "6.0.2",
    "amqplib": "0.10.9",
    "ethereum-bloom-filters": "1.2.0",
    "pg": "8.16.3",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.9",
    "@types/supertest": "6.0.3",
    "axios": "1.13.2",
    "@types/amqplib": "0.10.7",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.2.2",
    "ethers": "5.8.0",
    "globals": "16.0.0",
    "jest": "30.0.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "@testcontainers/rabbitmq": "10.10.0",
    "testcontainers": "10.28.0",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "jest": {
    "preset": "../../../jest.base.config.js",
    "moduleNameMapper": {
      "@domain(.*)$": "<rootDir>/src/domain/$1",
      "@app(.*)$": "<rootDir>/src/app/$1",
      "@port(.*)$": "<rootDir>/src/port.adapter/$1"
    }
  }
}
