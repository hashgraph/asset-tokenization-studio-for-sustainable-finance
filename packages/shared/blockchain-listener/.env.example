HEDERA_NETWORK=testnet
BLOCKCHAIN_LISTENER_BLOCK_NUMBER=25169554
BLOCKCHAIN_LISTENER_POLL_INTERVAL=3000
# Contracts and events should have semicolon separated values
BLOCKCHAIN_LISTENER_CONTRACTS=0xfd22c05d4d922f01baf6538237c80d1b0ec485b8
BLOCKCHAIN_LISTENER_EVENTS=Transfer(address indexed from,address indexed to,uint256 value)

# RabbitMQ configuration (reuses same instance as transaction-sender)
# If not provided, publishing is disabled gracefully
RABBITMQ_URI=amqp://localhost:5672
RABBITMQ_EXCHANGE_NAME=greenbond.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_BLOCKCHAIN_EVENTS_ROUTING_KEY=blockchain.events.processed
# Optional: also publish raw event payload stored in EventStore
BLOCKCHAIN_LISTENER_RABBITMQ_PUBLISH_RAW=false
RABBITMQ_BLOCKCHAIN_EVENTS_RAW_ROUTING_KEY=blockchain.events.raw
# Optional: disable persistent messages (default is true)
BLOCKCHAIN_LISTENER_RABBITMQ_PERSISTENT=true