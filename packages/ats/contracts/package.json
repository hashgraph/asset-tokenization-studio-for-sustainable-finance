{
    "name": "@hashgraph/green-bonds-platform-ats-contracts",
    "version": "1.0.0",
    "type": "commonjs",
    "main": "./build/typechain-types/index.js",
    "files": [
        "build/",
        "contracts/"
    ],
    "exports": {
        ".": {
            "import": "./build/typechain-types/index.js",
            "require": "./build/typechain-types/index.js",
            "default": "./build/typechain-types/index.js"
        },
        "./typechain-types/index.js": "./build/typechain-types/index.js"
    },
    "keywords": [
        "hedera",
        "smart-contracts",
        "tokenization",
        "hardhat"
    ],
    "author": "",
    "license": "Apache-2.0",
    "scripts": {
        "clean": "npm run clean:cache; npm run clean:build; npm run clean:node",
        "clean:cache": "npx hardhat clean",
        "clean:build": "node -e \"const fs=require('fs'); ['build','typechain-types','artifacts'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
        "clean:node": "node -e \"const fs=require('fs'); fs.rmSync('node_modules',{recursive:true,force:true})\"",
        "compile": "npx hardhat compile",
        "compile:force": "npm run clean && npm run compile",
        "test": "npx hardhat test",
        "lint:sol": "solhint 'contracts/**/*.sol'",
        "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix --noPrompt",
        "coverage": "npx hardhat coverage"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@hashgraph/asset-tokenization-contracts": "1.15.2",
        "@hashgraph/sdk": "^2.62.0",
        "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
        "@nomicfoundation/hardhat-toolbox": "^2.0.2",
        "@onchain-id/solidity": "^2.2.1",
        "@openzeppelin/contracts": "^4.9.6",
        "@openzeppelin/contracts-upgradeable": "^4.9.6",
        "@openzeppelin/hardhat-upgrades": "^1.22.1",
        "@primitivefi/hardhat-dodoc": "^0.2.3",
        "@terminal3/ecdsa_vc": "^0.1.19",
        "@thomaschaplin/isin-generator": "^1.0.3",
        "@tokenysolutions/t-rex": "^4.1.6",
        "@typechain/ethers-v5": "^11.1.2",
        "@typechain/hardhat": "^6.1.2",
        "@types/jest": "^29.5.14",
        "chai": "^4.4.0",
        "dotenv": "^16.0.3",
        "eslint": "^9.36.0",
        "ethers": "^5.8.0",
        "glob": "^11.0.3",
        "hardhat": "^v2.26.3",
        "hardhat-abi-exporter": "^2.11.0",
        "hardhat-contract-sizer": "^2.10.0",
        "hardhat-dependency-compiler": "^1.2.1",
        "jiti": "^2.6.0",
        "prettier-plugin-solidity": "^2.1.0",
        "solhint": "^6.0.1",
        "solidity-coverage": "^0.8.16",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.44.1"
    },
    "overrides": {
        "@typechain/ethers-v5": "^11.1.2",
        "ws": "^8.15.0"
    }
}