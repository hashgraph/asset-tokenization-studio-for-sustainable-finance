{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@contracts": ["./typechain-types/index.ts"],
      "@scripts": ["./scripts/index.ts"],
      "@scripts/domain": ["./scripts/domain/index.ts"],
      "@tasks": ["./tasks/index.ts"],
      "@test": ["./test/index.ts"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
