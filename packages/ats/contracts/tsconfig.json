{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@configuration": ["./Configuration.ts"],
      "@typechain": ["./typechain-types/index.ts"],
      "@typechain/*": ["./typechain-types/*"],
      "@scripts": ["./scripts/index.ts"],
      "@scripts/*": ["./scripts/*"],
      "@scripts/domain": ["./scripts/domain/index.ts"],
      "@scripts/domain/*": ["./scripts/domain/*"],
      "@test": ["./test/index.ts"],
      "@test/*": ["./test/*"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
