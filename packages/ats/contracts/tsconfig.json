{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "alwaysStrict": true,
    "strict": true,
    "outDir": "./build",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@configuration": ["./Configuration.ts"],
      "@contract-types": ["./typechain-types/index.ts"],
      "@contract-types/*": ["./typechain-types/*"],
      "@scripts": ["./scripts/index.ts"],
      "@scripts/infrastructure": ["./scripts/infrastructure/index.ts"],
      "@scripts/domain": ["./scripts/domain/index.ts"],
      "@tasks": ["./tasks/index.ts"],
      "@test": ["./test/index.ts"],
      "ats-test-helpers": ["./node_modules/@hashgraph/asset-tokenization-contracts/build/test/helpers/index"]
    }
  },
  "include": ["Configuration.ts", "scripts/**/*", "typechain-types/**/*", "test/**/*", "tasks/**/*"],
  "exclude": ["node_modules"]
}
