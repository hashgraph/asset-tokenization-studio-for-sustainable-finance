{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./build",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@contract-types": ["./typechain-types/index.ts"],
      "@contract-types/*": ["./typechain-types/*"],
      "@scripts": ["./scripts/index.ts"],
      "@scripts/domain": ["./scripts/domain/index.ts"],
      "@tasks": ["./tasks/index.ts"],
      "@test": ["./test/index.ts"],
      "@hashgraph/asset-tokenization-contracts/scripts": [
        "node_modules/@hashgraph/asset-tokenization-contracts/build/scripts/index.d.ts"
      ],
      "@hashgraph/asset-tokenization-contracts/scripts/*": [
        "node_modules/@hashgraph/asset-tokenization-contracts/build/scripts/*"
      ]
    }
  },
  "include": ["typechain-types/**/*"],
  "exclude": [
    "node_modules/@hashgraph/asset-tokenization-contracts/scripts",
    "node_modules/@hashgraph/asset-tokenization-contracts/test",
    "node_modules",
    "build",
    "dist",
    "coverage",
    "artifacts",
    "cache"
  ]
}
