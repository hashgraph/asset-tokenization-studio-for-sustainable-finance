{
  "name": "@hashgraph/green-bonds-platform-primarymarket-contracts",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "./build/typechain-types/index.js",
  "types": "./build/typechain-types/index.d.ts",
  "typesVersions": {
    "*": {
      "scripts": ["./build/scripts/index.d.ts"],
      "typechain-types": ["./build/typechain-types/index.d.ts"],
      "test": ["./build/test/index.d.ts"]
    }
  },
  "files": ["artifacts/", "contracts/", "typechain-types/", "build/", "!artifacts/build-info/", "!build/**/*.map"],
  "exports": {
    ".": {
      "types": "./build/typechain-types/index.d.ts",
      "import": "./build/typechain-types/index.js",
      "require": "./build/typechain-types/index.js",
      "default": "./build/typechain-types/index.js"
    },
    "./artifacts/*": "./artifacts/*",
    "./contracts/*": "./contracts/*",
    "./scripts": {
      "types": "./build/scripts/index.d.ts",
      "import": "./build/scripts/index.js",
      "require": "./build/scripts/index.js",
      "default": "./build/scripts/index.js"
    },
    "./typechain-types": {
      "types": "./build/typechain-types/index.d.ts",
      "import": "./build/typechain-types/index.js",
      "require": "./build/typechain-types/index.js",
      "default": "./build/typechain-types/index.js"
    },
    "./test": {
      "types": "./build/test/index.d.ts",
      "import": "./build/test/index.js",
      "require": "./build/test/index.js",
      "default": "./build/test/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": ["hedera", "smart-contracts", "tokenization", "hardhat"],
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('build',{recursive:true,force:true})\" && npm run compile && npx tsc -p tsconfig.build.json && npx tsc-alias -p tsconfig.build.json",
    "clean": "npm run clean:cache; npm run clean:build; npm run clean:node",
    "clean:cache": "npx hardhat clean",
    "clean:build": "node -e \"const fs=require('fs'); ['dist','build','artifacts','cache','typechain-types','coverage','.nyc_output'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "clean:node": "node -e \"const fs=require('fs'); fs.rmSync('node_modules',{recursive:true,force:true})\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:sol; npm run lint:js",
    "lint:fix": "npm run lint:sol:fix; npm run lint:js:fix",
    "lint:sol": "solhint --config solhint.config.js 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint --config solhint.config.js 'contracts/**/*.sol' --fix --noPrompt",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "generate:registry": "npx ts-node -r tsconfig-paths/register scripts/tools/generateRegistry.ts",
    "compile": "npx hardhat compile",
    "compile:force": " npx hardhat compile --force",
    "test": "npx hardhat test",
    "test:factory-primaryMarketFacet": "npx hardhat test test/unit/factoryPrimaryMarketFacet.test.ts",
    "test:factory-primaryMarket": "npx hardhat test test/unit/factoryPrimaryMarket.test.ts",
    "test:primaryMarketFacet": "npx hardhat test test/unit/primaryMarketFacet.test.ts",
    "test:primaryMarket": "npx hardhat test test/unit/primaryMarket.test.ts",
    "coverage": "npx hardhat coverage",
    "coverage:factory-primaryMarket": "npx hardhat coverage --solcoverjs .solcover.factory-primaryMarket.js --testfiles 'test/unit/factoryPrimaryMarket*.test.ts'",
    "coverage:primaryMarket": "npx hardhat coverage --solcoverjs .solcover.primaryMarket.js --testfiles 'test/unit/primaryMarket*.test.ts'"
  },
  "devDependencies": {
    "@hashgraph/asset-tokenization-contracts": "https://github.com/hashgraph/asset-tokenization-studio/raw/refs/heads/tgz/hashgraph-asset-tokenization-contracts-1.17.9.tgz",
    "@hashgraph/smart-contracts": "github:hashgraph/hedera-smart-contracts#v0.10.1",
    "@eslint/js": "^9.36.0",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@primitivefi/hardhat-dodoc": "^0.2.3",
    "@terminal3/ecdsa_vc": "^0.1.19",
    "@thomaschaplin/isin-generator": "^1.0.3",
    "@tokenysolutions/t-rex": "^4.1.6",
    "@typechain/ethers-v5": "10.2.1",
    "@typechain/hardhat": "6.1.2",
    "chai": "^4.4.0",
    "dotenv": "^16.0.3",
    "eslint": "^9.36.0",
    "ethers": "^5.8.0",
    "hardhat": "2.26.5",
    "hardhat-contract-sizer": "^2.10.0",
    "jiti": "^2.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "overrides": {
    "@typechain/ethers-v5": "10.2.1",
    "ws": "^8.15.0"
  }
}
