# Application
NODE_ENV=production
PORT=3010
LOG_LEVEL=log

# Database
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=oracle_user
POSTGRESQL_PASSWORD=<strong-password>
POSTGRESQL_DB=oracle_db
DB_LOGGING=false

# Hedera Transaction Signing
PRIVATE_KEY=302e020100300506032b65700422042012345...  # ED25519 private key
ACCOUNT_ID=0.0.98765                                  # Hedera account
HEDERA_NETWORK=testnet                                # testnet/mainnet/previewnet
HEDERA_USE_JSON_RPC=false                             # true=JSON-RPC, false=SDK
RPC_ENDPOINT=https://testnet.hashio.io/api

# MSG Indexer
INDEXER_ENDPOINT=https://indexer.guardianservice.app/api/v1
INDEXER_API_KEY=eyJhbGc...

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_CRON_EXPRESSION=*/1 * * * *                 # Check every 1 minute (cron format)
SCHEDULER_CONCURRENCY_LIMIT=5                         # Max parallel KPI executions per registry

# Note: Each oracle registry has its own frequencyMinutes configuration
# The scheduler checks every minute, but each registry executes based on its own frequency

# Error Handling
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=10                                # Initial retry delay (exponential backoff)
