{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "e2e/.*\\.e2e\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/../src/app/$1",
    "^@domain/(.*)$": "<rootDir>/../src/domain/$1",
    "^@port/(.*)$": "<rootDir>/../src/port.adapter/$1"
  },
  "testTimeout": 120000
}
