# RabbitMQ Configuration
# Connection URI for RabbitMQ broker
RABBITMQ_URI=amqp://localhost:5672

# Exchange configuration
RABBITMQ_EXCHANGE_NAME=tx
RABBITMQ_EXCHANGE_TYPE=topic

# Hedera transaction configuration
RABBITMQ_HEDERA_QUEUE_NAME=hederaFormat.incoming
RABBITMQ_HEDERA_ROUTING_KEY=hederaFormat.incoming

# Ethereum transaction configuration
RABBITMQ_ETHEREUM_QUEUE_NAME=ethereumFormat.incoming
RABBITMQ_ETHEREUM_ROUTING_KEY=ethereumFormat.incoming

# Connection options
RABBITMQ_CONNECTION_WAIT=false

# Hedera Network Configuration
# Supported values: testnet, mainnet, previewnet, local
HEDERA_NETWORK=testnet

# Ethereum Network Configuration (maps to HashIO URLs)
# Supported values: testnet, mainnet, previewnet, local
ETHEREUM_NETWORK=testnet

# Logging Configuration
LOG_LEVEL=info

# Application port
PORT=3000