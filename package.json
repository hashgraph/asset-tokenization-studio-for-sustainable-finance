{
  "name": "@hashgraph/green-bonds-platform",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/ats/api",
    "apps/primary-market/api",
    "apps/shared/gateway",
    "apps/shared/transaction-sender",
    "apps/treasury/api",
    "packages/ats/contracts",
    "packages/primary-market/contracts",
    "packages/shared/blockchain-listener",
    "packages/shared/contracts",
    "packages/shared/core",
    "packages/treasury/contracts",
    "scripts"
  ],
  "scripts": {
    "clean": "npm run ats:contracts:clean && npm run primary-market:contracts:clean && npm run treasury:contracts:clean && npm run shared:contracts:clean && node -e \"const fs=require('fs'); fs.rmSync('node_modules', {recursive:true, force:true})\"",
    "clean:force": "node scripts/clean-force.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "node .github/scripts/format-changed.js",
    "format:changed:check": "node .github/scripts/format-changed.js --check",
    "lint": "npm run lint:js && npm run lint:sol",
    "lint:fix": "npm run lint:js:fix && npm run lint:sol:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:js:changed": "node .github/scripts/lint-js-changed.js",
    "lint:js:changed:fix": "node .github/scripts/lint-js-changed.js --fix",
    "lint:sol": "solhint 'packages/*/contracts/contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'packages/*/contracts/contracts/**/*.sol' --fix --noPrompt",
    "lint:sol:changed": "node .github/scripts/lint-sol-changed.js",
    "lint:sol:changed:fix": "node .github/scripts/lint-sol-changed.js --fix",
    "lint:changed": "npm run lint:js:changed && npm run lint:sol:changed",
    "lint:changed:fix": "npm run lint:js:changed:fix && npm run lint:sol:changed:fix",
    "quality:changed": "npm run format:changed:check && npm run lint:changed",
    "contracts:format": "npm run ats:contracts:format && npm run primary-market:contracts:format && npm run treasury:contracts:format && npm run shared:contracts:format",
    "contracts:format:check": "npm run ats:contracts:format:check && npm run primary-market:contracts:format:check && npm run treasury:contracts:format:check && npm run shared:contracts:format:check",
    "contracts:lint": "npm run ats:contracts:lint && npm run primary-market:contracts:lint && npm run treasury:contracts:lint && npm run shared:contracts:lint",
    "contracts:lint:fix": "npm run ats:contracts:lint:fix && npm run primary-market:contracts:lint:fix && npm run treasury:contracts:lint:fix && npm run shared:contracts:lint:fix",
    "contracts:build": "npm run treasury:contracts:build && npm run primary-market:contracts:build && npm run ats:contracts:build && npm run shared:contracts:build",
    "ats:contracts:clean": "npm run clean --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:compile": "npm run compile --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:build": "npm run build --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:format": "npm run format --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:format:check": "npm run format:check --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:lint": "npm run lint --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:lint:fix": "npm run lint:fix --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:test": "npm run test --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:test:factory-suite": "npm run test:factory-suite --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:test:kpi": "npm run test:kpi --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:test:integration": "npm run test:integration --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:coverage": "npm run coverage --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:coverage:factory-suite": "npm run coverage:factory-suite --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:contracts:coverage:kpi": "npm run coverage:kpi --workspace=@hashgraph/green-bonds-platform-ats-contracts",
    "ats:api:build": "npm run build --workspace=@hashgraph/green-bonds-ats-api",
    "ats:api:start": "npm run start --workspace=@hashgraph/green-bonds-ats-api",
    "treasury:contracts:clean": "npm run clean --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "treasury:contracts:format": "npm run format --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "treasury:contracts:format:check": "npm run format:check --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "treasury:contracts:lint": "npm run lint --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "treasury:contracts:lint:fix": "npm run lint:fix --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "treasury:contracts:build": "npm run build --workspace=@hashgraph/green-bonds-platform-treasury-contracts",
    "primary-market:contracts:clean": "npm run clean --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "primary-market:contracts:format": "npm run format --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "primary-market:contracts:format:check": "npm run format:check --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "primary-market:contracts:lint": "npm run lint --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "primary-market:contracts:lint:fix": "npm run lint:fix --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "primary-market:contracts:build": "npm run build --workspace=@hashgraph/green-bonds-platform-primarymarket-contracts",
    "shared:build": "npm run shared:core:build && npm run shared:listener:build",
    "shared:core:build": "npm run build --workspace=@hashgraph/green-bonds-shared-core",
    "shared:listener:build": "npm run build --workspace=@hashgraph/green-bonds-blockchain-listener",
    "shared:contracts:clean": "npm run clean --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:format": "npm run format --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:format:check": "npm run format:check --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:lint": "npm run lint --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:lint:fix": "npm run lint:fix --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:build": "npm run build --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:local": "npm run deploy:local --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:local:auto": "npm run deploy:local:auto --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:hedera:local": "npm run deploy:hedera:local --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:hedera:preview": "npm run deploy:hedera:preview --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:hedera:testnet": "npm run deploy:hedera:testnet --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "shared:contracts:deploy:hedera:mainnet": "npm run deploy:hedera:mainnet --workspace=@hashgraph/green-bonds-platform-shared-contracts",
    "scripts:docker:start": "npm run docker:start --workspace=@hashgraph/green-bonds-scripts",
    "scripts:docker:stop": "npm run docker:stop --workspace=@hashgraph/green-bonds-scripts",
    "scripts:gbp:start": "npm run all:start --workspace=@hashgraph/green-bonds-scripts",
    "scripts:gbp:stop": "npm run all:stop --workspace=@hashgraph/green-bonds-scripts",
    "scripts:test:bond": "npm run bond --workspace=@hashgraph/green-bonds-scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "class-validator": "0.14.2",
    "eslint": "9.37.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unused-imports": "4.2.0",
    "globals": "16.4.0",
    "hardhat": "2.26.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.1.0"
  },
  "overrides": {
    "@typechain/ethers-v5": "10.2.1",
    "ws": "8.18.3"
  }
}
